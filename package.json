{
  "name": "personal-finance-app",
  "version": "1.0.0",
  "description": "A comprehensive personal finance management application with OCR receipt scanning and AI-powered insights",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "test": "cd frontend && npm test",
    "test:backend": "cd backend && npm test",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "heroku-postbuild": "npm run install:all && npm run build"
  },
  "keywords": [
    "finance",
    "personal-finance",
    "expense-tracking",
    "react",
    "nodejs",
    "mongodb",
    "ocr",
    "ai-insights",
    "dashboard",
    "analytics"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/personal-finance-app.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/personal-finance-app/issues"
  },
  "homepage": "https://github.com/yourusername/personal-finance-app#readme",
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "nodemailer": "^7.0.3"
  }
}
